# Значения для локального стенда. Compose читает этот файл как значения по умолчанию,
# поэтому `docker-compose up` работает без ручной подготовки. Чтобы заменить значения,
# скопируйте файл в .env (в репозиторий он не попадает) и поменяйте нужные строки.

# Порт PostgreSQL на хосте
POSTGRES_HOST_PORT=55432

# Суперпользователь контейнера: только создание баз и ролей
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_admin_change_me

# Подключение pipeline к PostgreSQL внутри сети compose
DB_HOST=postgres
DB_PORT=5432

# Источник: роль только для чтения
SOURCE_DB=deals_bigdata
SOURCE_USER=source_reader
SOURCE_PASSWORD=local_source_change_me

# Хранилище: владелец схем
DWH_DB=dwh
DWH_USER=dwh_etl
DWH_PASSWORD=local_etl_change_me

# BI: чтение схемы mart
BI_PASSWORD=local_bi_change_me

# Генератор источника
N_PRICES=300000

# Дата снимка. Системная дата в логике не используется.
AS_OF=2026-10-26

# ML
ML_SEED=42
ML_THREADS=4
MODEL_DIR=/artifacts

LOG_LEVEL=INFO
