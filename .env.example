# Значения для локального стенда. Контейнеры получают этот файл через env_file как значения по умолчанию,
# поэтому `docker-compose up` работает без ручной подготовки. Чтобы заменить значения,
# скопируйте файл в .env (в репозиторий он не попадает) и поменяйте нужные строки.

# HOST_BIND и *_HOST_PORT подставляются в docker-compose.yml только из .env или окружения shell, этот файл для них
# справочный: значения по умолчанию прописаны в docker-compose.yml. Пароли и остальное контейнеры читают отсюда.

# Адрес, на котором публикуются порты стенда. 0.0.0.0 открывает стенд для всей сети: тогда смените пароли
HOST_BIND=127.0.0.1

# Порт PostgreSQL на хосте
POSTGRES_HOST_PORT=55432

# Суперпользователь контейнера: только создание баз и ролей
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_admin_change_me

# Подключение pipeline к PostgreSQL внутри сети compose
DB_HOST=postgres
DB_PORT=5432

# Источник: роль только для чтения
SOURCE_DB=deals_bigdata
SOURCE_USER=source_reader
SOURCE_PASSWORD=local_source_change_me

# Хранилище: владелец схем
DWH_DB=dwh
DWH_USER=dwh_etl
DWH_PASSWORD=local_etl_change_me

# BI: чтение схемы mart
BI_PASSWORD=local_bi_change_me

# Генератор источника
N_PRICES=300000

# Дата снимка. Системная дата в логике не используется.
AS_OF=2026-10-26

# ML
ML_SEED=42
ML_THREADS=4
MODEL_DIR=/artifacts

LOG_LEVEL=INFO

# Сколько шаг ждёт, пока другой прогон освободит хранилище, затем падает. Формат lock_timeout PostgreSQL
PIPELINE_LOCK_TIMEOUT=15min

# Какую долю строк окна или справочника источник может потерять за одну загрузку. Больше похоже
# на неполный снимок, и загрузка останавливается. Для намеренного удаления запустите с 1
SOURCE_SHRINK_LIMIT=0.05

# pytest: если PostgreSQL недоступен, интеграционные тесты падают, а не пропускаются
REQUIRE_DB=1

# Метаданные Airflow и Superset, профили airflow и superset
METADATA_DB_HOST=meta-postgres
METADATA_DB_PORT=5432
AIRFLOW_DB_PASSWORD=local_airflow_meta_change_me
SUPERSET_DB_PASSWORD=local_superset_meta_change_me

# Superset, профиль superset. Порт на хосте: SUPERSET_HOST_PORT, по умолчанию 8088
SUPERSET_SECRET_KEY=local_superset_secret_key_change_me_0123456789
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=local_superset_admin_change_me

# Airflow, профиль airflow. Порт на хосте: AIRFLOW_HOST_PORT, по умолчанию 8081
AIRFLOW__WEBSERVER__SECRET_KEY=local_airflow_secret_key_change_me
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=local_airflow_admin_change_me
# Сколько секунд airflow-trigger ждёт завершения полного запуска DAG, затем выходит с ошибкой
AIRFLOW_TRIGGER_TIMEOUT=3600

# ClickHouse, профиль clickhouse. Порт HTTP на хосте: CLICKHOUSE_HOST_PORT, по умолчанию 58123
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=market
CLICKHOUSE_USER=market
CLICKHOUSE_PASSWORD=local_clickhouse_change_me
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
